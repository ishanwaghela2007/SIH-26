generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkerOnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum WorkerDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model WorkerProfile {
  id                String                  @id @default(uuid())
  userId            String                  @unique
  bio               String?
  district          String?
  serviceDomains    String[]
  languages         String[]
  status            WorkerOnboardingStatus  @default(DRAFT)
  submittedAt       DateTime?
  verifiedAt        DateTime?
  rejectionReason   String?
  skills            WorkerSkill[]
  documents         WorkerDocument[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status])
  @@index([district])
}

model WorkerSkill {
  id          String        @id @default(uuid())
  workerId    String
  name        String
  proficiency String?
  verified    Boolean       @default(false)
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workerId, name])
  @@index([name])
}

model WorkerDocument {
  id              String               @id @default(uuid())
  workerId        String
  type            String
  storageKey      String
  status          WorkerDocumentStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  worker          WorkerProfile        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([workerId, status])
  @@index([type])
}
