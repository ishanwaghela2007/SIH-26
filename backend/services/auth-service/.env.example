NODE_ENV=development
PORT=3001
GRPC_PORT=50051

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# JWT: prefer RS256 in shared environments. Keep the private key only here.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-for-local-development
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Argon2id tuning
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Redis and Kafka
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-service
# 32-byte base64 key used to encrypt one-time secrets in outbox events.
AUTH_EVENT_ENCRYPTION_KEY=

# Google ID-token verification
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# One-time token expiry
EMAIL_VERIFICATION_EXPIRES_MINUTES=1440
PASSWORD_RESET_EXPIRES_MINUTES=30

# Distributed rate limiting
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX=10
LOGIN_ATTEMPT_MAX=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=30
EMAIL_RESEND_RATE_LIMIT_MAX=5
PASSWORD_FORGOT_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_MAX=10
GOOGLE_RATE_LIMIT_MAX=10
EMAIL_VERIFY_RATE_LIMIT_MAX=10

# Optional secure one-time admin bootstrap. Never commit real values.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
