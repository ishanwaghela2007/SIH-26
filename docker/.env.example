NODE_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=auth_db
AUTH_DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/auth_db
WORKER_DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/worker_db
JOB_DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/job_db
BOOKING_DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/booking_db

REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092

AUTH_PORT=3001
AUTH_GRPC_PORT=50051
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_EVENT_ENCRYPTION_KEY=

WORKER_PORT=3002
JOB_PORT=3003
BOOKING_PORT=3004
LANGUAGE_PORT=3005
AUTH_GRPC_URL=auth-service:50051
JOB_SERVICE_URL=http://job-service:3003
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=30000

KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
